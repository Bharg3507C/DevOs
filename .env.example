# ---- DevOS environment configuration ----
# Copy to .env and fill in. Never commit .env.

# --- Backend ---
# Postgres
POSTGRES_USER=devos
POSTGRES_PASSWORD=devos
POSTGRES_DB=devos
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# SQLAlchemy URL (derived from the above by default; override if needed)
DATABASE_URL=postgresql+psycopg://devos:devos@postgres:5432/devos

# Redis
REDIS_URL=redis://redis:6379/0

# Session / security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me-to-a-long-random-string
# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:5173

# Where OAuth flows send the user back to (the frontend app).
FRONTEND_BASE_URL=http://localhost:5173

# GitHub OAuth (create an OAuth App at https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:8000/api/auth/github/callback

# GitLab OAuth (create an Application at https://gitlab.com/-/profile/applications)
# Scopes: read_api read_user read_repository. Set GITLAB_BASE_URL for self-managed.
GITLAB_BASE_URL=https://gitlab.com
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_OAUTH_CALLBACK_URL=http://localhost:8000/api/auth/gitlab/callback

# Analysis sandbox / limits
DEVOS_WORKDIR=/tmp/devos-work
DEVOS_MAX_FILE_BYTES=2000000
DEVOS_MAX_FILES=50000
DEVOS_CLONE_TIMEOUT_SECONDS=300

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000
